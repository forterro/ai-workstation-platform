{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Paris",
  "semanticCommits": "enabled",
  "labels": ["dependencies"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "separateMultipleMajor": true,
  "packageRules": [
    {
      "description": "Group every minor/patch/digest update into a single PR; majors stay on their own PR, one per major version (separateMultipleMajor).",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    }
  ],
  "postUpgradeTasks": {
    "commands": ["make deps"],
    "fileFilters": ["**/Chart.lock", "**/charts/*.tgz"],
    "executionMode": "branch"
  },
  "helmv3": {
    "fileMatch": ["(^|/)Chart\\.yaml$"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump image tags and CLI versions annotated with a # renovate: comment",
      "fileMatch": ["(^|/)values\\.yaml$", "(^|/)tool-versions\\.yaml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s*\\n\\s*[A-Za-z0-9_.-]+:\\s*[\"']?(?<currentValue>[^\"'\\s]+)"
      ]
    }
  ]
}
