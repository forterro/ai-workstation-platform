{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "AI Stack Perf",
  "uid": "ai-stack-perf",
  "tags": ["ai", "vllm", "litellm", "gpu"],
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "vLLM — latency & throughput", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 1, "collapsed": false },
    {
      "id": 2, "type": "timeseries", "title": "TTFT (time to first token)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum(rate(vllm:time_to_first_token_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(vllm:time_to_first_token_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "TPOT (time per output token)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum(rate(vllm:request_time_per_output_token_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(vllm:request_time_per_output_token_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Throughput (tokens/sec)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "tps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(vllm:generation_tokens_total[$__rate_interval]))", "legendFormat": "generation" },
        { "refId": "B", "expr": "sum(rate(vllm:prompt_tokens_total[$__rate_interval]))", "legendFormat": "prompt (prefill)" }
      ]
    },
    { "type": "row", "title": "vLLM — KV cache & scheduling", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "id": 10, "collapsed": false },
    {
      "id": 11, "type": "timeseries", "title": "KV cache usage",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "vllm:kv_cache_usage_perc", "legendFormat": "kv usage" } ]
    },
    {
      "id": 12, "type": "timeseries", "title": "GPU prefix cache hit rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "vllm:gpu_prefix_cache_hit_rate", "legendFormat": "hit rate" } ]
    },
    {
      "id": 13, "type": "timeseries", "title": "Requests running / waiting / swapped",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(vllm:num_requests_running)", "legendFormat": "running" },
        { "refId": "B", "expr": "sum(vllm:num_requests_waiting)", "legendFormat": "waiting" },
        { "refId": "C", "expr": "sum(vllm:num_requests_swapped)", "legendFormat": "swapped" }
      ]
    },
    { "type": "row", "title": "GPU (DCGM)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }, "id": 20, "collapsed": false },
    {
      "id": 21, "type": "timeseries", "title": "GPU utilization",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "GPU {{gpu}}" } ]
    },
    {
      "id": 22, "type": "timeseries", "title": "VRAM used",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "decmbytes" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "DCGM_FI_DEV_FB_USED", "legendFormat": "used GPU {{gpu}}" } ]
    },
    {
      "id": 23, "type": "timeseries", "title": "GPU power",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "watt" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "DCGM_FI_DEV_POWER_USAGE", "legendFormat": "GPU {{gpu}}" } ]
    },
    {
      "id": 24, "type": "timeseries", "title": "GPU temp / SM clock",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "celsius" }, "overrides": [ { "matcher": { "id": "byName", "options": "SM clock (MHz)" }, "properties": [ { "id": "unit", "value": "rothz" } ] } ] },
      "targets": [
        { "refId": "A", "expr": "DCGM_FI_DEV_GPU_TEMP", "legendFormat": "temp" },
        { "refId": "B", "expr": "DCGM_FI_DEV_SM_CLOCK", "legendFormat": "SM clock (MHz)" }
      ]
    },
    { "type": "row", "title": "Per-model (local vs Mistral) — via LiteLLM", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }, "id": 30, "collapsed": false },
    {
      "id": 31, "type": "timeseries", "title": "TTFT p95 by model",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(litellm_llm_api_time_to_first_token_metric_bucket[$__rate_interval])) by (le, model))", "legendFormat": "{{model}}" } ]
    },
    {
      "id": 32, "type": "timeseries", "title": "Total request latency p95 by model",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(litellm_request_total_latency_metric_bucket[$__rate_interval])) by (le, model))", "legendFormat": "{{model}}" } ]
    },
    {
      "id": 33, "type": "timeseries", "title": "Output tokens/sec by model",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "tps" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(rate(litellm_output_tokens_metric_total[$__rate_interval])) by (model)", "legendFormat": "{{model}}" } ]
    },
    { "type": "row", "title": "Tool calls & spend", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 }, "id": 40, "collapsed": false },
    {
      "id": 41, "type": "timeseries", "title": "Tool-call parser invocations/sec",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(rate(vllm:tool_call_parser_invocations_total[$__rate_interval]))", "legendFormat": "tool calls/s" } ]
    },
    {
      "id": 42, "type": "timeseries", "title": "LiteLLM spend rate by model",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(rate(litellm_spend_metric_total[$__rate_interval])) by (model)", "legendFormat": "{{model}}" } ]
    }
  ]
}
